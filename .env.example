# Base URL for Idle MMO web client
BASE_URL=https://web.idle-mmo.com

# Poll interval in milliseconds when monitoring gather state
POLL_MS=5000

# Run browser headless (true/false)
HEADLESS=true

# Path to Playwright storage state (cookies/session from logged-in browser)
STORAGE_STATE=./storage-state.json

# In-game character this process drives (optional — unset keeps legacy single-character paths)
# CHARACTER_NAME=IdleBocchi
# Comma-separated in-account alts to rotate when gatherBusy (unset = no rotation)
# CHARACTER_ROSTER=IdleBocchi,MinerAlt,FisherAlt
# ACCOUNT_SLUG=idlebocchi
# Auto log/playbook paths when CHARACTER_NAME is set: logs/{accountSlug}/{characterSlug}/
# SKIP_CHARACTER_ENSURE=false
# CREATE_CHARACTER_IF_MISSING=false
# CHARACTER_DEFAULT_CLASS=Miner
# CHARACTER_SELECTOR_ROUTE=/character

# Auto-buy Cheap Bait when fishing (false by default; use --buy-bait flag instead)
BUY_BAIT=false

# Click Start anyway on replace dialog for combat (false by default; use --interrupt flag)
FORCE_INTERRUPT=false

# TypeSafe Jev API (optional — without a token, StubJev is used)
# JEV_API_TOKEN=your-typesafe-api-key
# Alias also accepted:
# TYPESAFE_API_KEY=your-typesafe-api-key

# Jev model (default: jev-latest)
# JEV_MODEL=jev-latest

# Noul yes threshold for interrupt/stop/flee decisions (default: 0.6)
# JEV_NOUL_THRESHOLD=0.6

# Comma-separated vendor-trash items autopilot may sell (never quest mats)
# JUNK_SELL_ITEMS=Burnt Cod,Burnt Fish,Burnt Salmon

# Structured overnight logs (gitignored); default: ./logs
# AUTOPILOT_LOG_DIR=./logs
# Playbook stage persistence defaults to $AUTOPILOT_LOG_DIR/playbook-state.json
# (or ./logs/playbook-state.json when AUTOPILOT_LOG_DIR is unset).
# PLAYBOOK_STATE_PATH=./logs/playbook-state.json

# Early-systems curriculum for HttpJev (default on). Set false to disable filters.
# EARLY_PLAYBOOK=true

# Sell surplus junk for gold when snapshot gold is below this (default 800)
# SELL_GOLD_THRESHOLD=800

# IdleMMO Public API (read-only /v1). Unset key = Playwright scrape only.
# Create the key in account settings → Public API. Never commit it.
# IDLE_MMO_API_KEY=
# HTTPS origin only. Default is https://api.idle-mmo.com (paths are /v1/…).
# IDLE_MMO_API_BASE=https://api.idle-mmo.com
# Character hashed id for /v1/character/{hashed_character_id}/information, current-action, and pets.
# If unset, the client resolves it from auth/check (and alt /characters) using CHARACTER_NAME.
# IDLE_MMO_CHARACTER_HASHED_ID=
# Optional guild id for allowlisted /v1/guild/{id}/… paths (one path segment).
# Autopilot refresh does not call guild routes every cycle. Not character inventory.
# IDLE_MMO_GUILD_ID=
