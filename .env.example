# Base URL for Idle MMO web client
BASE_URL=https://web.idle-mmo.com

# Poll interval in milliseconds when monitoring gather state
POLL_MS=5000

# Run browser headless (true/false)
HEADLESS=true

# Path to Playwright storage state (cookies/session from logged-in browser)
STORAGE_STATE=./storage-state.json

# Auto-buy Cheap Bait when fishing (false by default; use --buy-bait flag instead)
BUY_BAIT=false

# Click Start anyway on replace dialog for combat (false by default; use --interrupt flag)
FORCE_INTERRUPT=false
